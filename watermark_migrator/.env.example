# Get these from https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Any string; a session file with this name will be created next to it on first login
SESSION_NAME=watermark_migrator

# Source and target: @username, invite link, or numeric chat id.
# You'll be prompted for these at every startup too (just press Enter to
# keep whatever's set here) - only fill these in if you want a default.
SOURCE_CHANNEL=
TARGET_CHANNEL=

# Folder with one or more clean, tightly-cropped reference images of the
# watermark badge (different sizes/variants) - drop as many .png/.jpg as you have
WATERMARK_TEMPLATES_DIR=watermark_migrator/templates

# Phrases to strip from captions / trigger a filename rename to "Prime Sector"
BRAND_TERMS_PATH=watermark_migrator/brand_terms.txt

# Where downloaded/intermediate files are stored during processing
WORK_DIR=watermark_migrator/work
DB_PATH=watermark_migrator/state.sqlite3

# Detection tuning
MATCH_THRESHOLD=0.7
SCALE_MIN=0.5
SCALE_MAX=2.5
SCALE_STEPS=25
SAMPLE_FRAMES=3

# Encoding
USE_GPU=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
NVENC_PRESET=p4
NVENC_CQ=19

# How many videos to process concurrently (tune to GPU NVENC sessions / disk / bandwidth)
CONCURRENCY=2

# What gets stamped over the (blurred) watermark box, two rows of it
MASK_TEXT=@#&@#%
# Leave blank to let ffmpeg pick a default font via fontconfig; set an exact
# path if that fails on your system, e.g. C:\Windows\Fonts\arialbd.ttf on
# Windows or /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf on Linux
FONT_FILE=
FONT_COLOR=white
FONT_OPACITY=0.85

# Optional: path to a PNG (transparent background) to stamp over the
# watermark instead of the text above - e.g. your own logo badge. Leave
# blank to use MASK_TEXT instead.
OVERLAY_IMAGE=
