# Get these from https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Any string; a session file with this name will be created next to it on first login
SESSION_NAME=watermark_migrator

# Source and target: @username, invite link, or numeric chat id
SOURCE_CHANNEL=
TARGET_CHANNEL=

# Path to a clean, tightly-cropped reference image of the watermark badge
WATERMARK_TEMPLATE=watermark_migrator/templates/watermark.png

# Where downloaded/intermediate files are stored during processing
WORK_DIR=watermark_migrator/work
DB_PATH=watermark_migrator/state.sqlite3

# Detection tuning
MATCH_THRESHOLD=0.7
SCALE_MIN=0.5
SCALE_MAX=2.5
SCALE_STEPS=25
SAMPLE_FRAMES=3

# Encoding
USE_GPU=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
NVENC_PRESET=p4
NVENC_CQ=19

# How many videos to process concurrently (tune to GPU NVENC sessions / disk / bandwidth)
CONCURRENCY=2
