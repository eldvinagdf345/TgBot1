# Получите на https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Имя файла сессии (создастся сам при первом запуске после ввода кода из Telegram)
SESSION_NAME=clone_session

# Источник: @username форума, или его числовой id (см. `python -m forum_clone.clone --list-chats`)
SOURCE_CHAT=

# Необязательно: id/username уже существующей ПУСТОЙ группы под клон.
# Если оставить пустым - скрипт сам создаст новую группу-форум с тем же названием.
TARGET_CHAT=

# Необязательно: другое название клона (по умолчанию берётся название источника)
TARGET_TITLE=

# Пауза между отправками сообщений, сек. (снижает риск лимитов Telegram)
DELAY_SECONDS=1.5

# Временная папка для скачанных медиа перед пересылкой
DOWNLOAD_DIR=./downloads

# Файл прогресса клонирования (для безопасного повторного запуска)
STATE_FILE=./state.json
